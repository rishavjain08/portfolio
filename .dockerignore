# Everything here is either rebuilt inside the image or irrelevant to it.
# Without this, `COPY . .` ships node_modules and the screenshot archive into
# the build context, which is most of a gigabyte of nothing.

node_modules
dist
dist-ssr

# Screenshots and the puppeteer scripts that produce them. Development tooling,
# never part of the served site.
shots
tools

# Docker's own files: copying them in would bust the cache on every edit.
Dockerfile
.dockerignore

.git
.gitignore

*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

.DS_Store
.vscode
.idea
*.local
